
APP_NAME="Heaven on Earth CMS"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=

DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

PASSWORD_HASH_ROUNDS=12
RATE_LIMIT_PER_MINUTE=60

MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=uploads

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Heaven on Earth CMS"
SMTP_USE_TLS=true

LOG_LEVEL=INFO
LOG_FORMAT=json
