
APP_NAME="Heaven on Earth CMS"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=

DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

PASSWORD_HASH_ROUNDS=12
RATE_LIMIT_PER_MINUTE=60

MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=uploads

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Heaven on Earth CMS"
SMTP_USE_TLS=true

LOG_LEVEL=INFO
LOG_FORMAT=json

# ─────────────────────────────────────────
# AI Chatbot Settings
# ─────────────────────────────────────────

# Required: Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=

# Required: Comma-separated URLs of church website pages to crawl for the knowledge base
CHATBOT_CRAWL_URLS=

# Optional overrides (defaults shown):
# CHATBOT_RATE_LIMIT=30               # Max chat messages per minute per IP
# CHAT_SESSION_TTL_MINUTES=30         # Idle session timeout in minutes
# KNOWLEDGE_BASE_REFRESH_DAYS=15      # How often to refresh events/ministries in the KB
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2  # Embedding model name
