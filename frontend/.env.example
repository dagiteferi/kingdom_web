# API Configuration
VITE_API_BASE_URL=https://api.example.com

# Sentry Configuration (Production Only)
VITE_SENTRY_DSN=your-sentry-dsn
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=v1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Security Headers
VITE_CSP_REPORT_URI=https://your-domain.report-uri.com/r/d/csp/enforce

# PWA Configuration
VITE_APP_NAME=Kingdom Project
VITE_APP_SHORT_NAME=Kingdom
VITE_APP_DESCRIPTION=Secure and performant web application

# Performance Settings
VITE_LAZY_LOAD_IMAGES=true
VITE_ENABLE_PREFETCH=true
