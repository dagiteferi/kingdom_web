# ==============================================
# Heaven on Earth CMS Backend - Environment Config
# ==============================================
# Copy this file to .env and update the values

# Application Settings
APP_NAME="Heaven on Earth CMS"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# Server Settings
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,https://heavenonearth.et

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/heavenonearth_cms
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT Security Settings
JWT_SECRET_KEY=your-super-secret-key-min-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Admin Credentials (Used only for first-time setup)
ADMIN_EMAIL=admin@heavenonearth.et
ADMIN_PASSWORD=ChangeThisSecurePassword123!
ADMIN_FULL_NAME=Super Admin

# Password Hashing
PASSWORD_HASH_ROUNDS=12

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
UPLOAD_DIR=uploads

# Email Settings (Optional - for sending invites)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@heavenonearth.et
SMTP_FROM_NAME=Heaven on Earth CMS

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
